# Copy this file to .env (same folder) and fill it in.  .env is gitignored: never commit it.
# Never prefix any of these with VITE_ (that would ship them to the browser).

# Required. Pick any long random password. Neo4j stores it on first start, so changing it later
# does not change the database's password.
NEO4J_PASSWORD=change-me-long-random

# Both colleagues are Claude and share this key. Leave it empty to run with scripted demo colleagues.
ANTHROPIC_API_KEY=
# Optional: only for the embeddings behind similar-note (vector) search. Anthropic has no embeddings API.
OPENAI_API_KEY=

# Models
CLAUDE_MODEL=claude-sonnet-5-5
SCEPTIC_MODEL=claude-haiku-5-5
EMBED_MODEL=text-embedding-3-small
EMBED_DIMS=1536

# Docker: where the app opens (http://localhost:8088) and your timezone
WEB_PORT=8088
TZ=Asia/Kolkata

# Only for running without Docker (npm run dev:server). Docker sets its own values.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
PORT=8787
